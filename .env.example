# Site (HTTPS público em produção se usado para assets de email)
NEXT_PUBLIC_SITE_URL=https://www.haxrsignature.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Logo público para emails (URL HTTPS absoluta).
# Deve ser acessível por clientes de email (Outlook, Gmail, etc.).
# Não usar localhost nem URLs internas.
# Recomendado: https://your-domain.com/images/brand/logo-horizontal-gold.png
HAXR_PUBLIC_LOGO_URL=

# Admin — usar secret independente da password
ADMIN_EMAIL=admin@haxrsignature.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client app auth — preview staging (Fase B.1, local dev only)
# Copy into .env.development.local (gitignored). Overrides .env.local in `npm run dev`.
# NEXT_PUBLIC_SUPABASE_URL=https://uxleigndoomoezwsxlan.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<preview anon key — Supabase dashboard → Settings → API>
# Do NOT point client sign-in tests at production (oxsrdmydlqyvnueedgtl).

# Preview smoke scripts (local only — copy values into .env.development.local)
# STAGING_TEST_EMAIL=
# STAGING_TEST_PASSWORD=
# STAGING_TEST_EVENT_ID=
# STAGING_TEST_BASE_URL=
# STAGING_TEST_EVENT_FINGERPRINT=

# Email transaccional — Resend (formulário de contacto)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=hello@haxrsignature.com
RESEND_FROM_EMAIL=HAXR Signature <hello@haxrsignature.com>
RESEND_BRAND_DOMAIN=true

# Marketing — Brevo (sync leads + funil + campanhas)
BREVO_API_KEY=
BREVO_LIST_LEADS=
BREVO_LIST_NEWSLETTER=
BREVO_MARKETING_LIST_ID=
BREVO_SUPPLIERS_LIST_ID=
BREVO_CLIENTS_LIST_ID=
BREVO_SENDER_EMAIL=hello@haxrsignature.com
BREVO_SENDER_NAME=HAXR Signature
# Modo de envio: disabled | test | production (default implícito: disabled)
EMAIL_SEND_MODE=disabled
# Destinatário único para testes (obrigatório quando EMAIL_SEND_MODE=test)
BREVO_TEST_RECIPIENT=

# WhatsApp convites — campanhas (default fail-closed: disabled)
# disabled | manual | preview_test | production
# manual = wa.me/copy/marcar enviado (sem provider automático)
# preview_test/production permanecem bloqueados sem provider+credenciais
# Blocker externo único para envio automático: configurar Meta WhatsApp Cloud API
# para um sender verificado, com provider_phone_id + token guardado em secret
# storage/credencial encriptada. Nunca colocar token WhatsApp em plaintext aqui.
HAXR_WHATSAPP_SEND_MODE=disabled
BREVO_FUNNEL_ENABLED=true
BREVO_FUNNEL_PORTFOLIO_DAYS=3
BREVO_FUNNEL_EXPERIENCES_DAYS=7
BREVO_FUNNEL_MEETING_DAYS=14
BREVO_FUNNEL_LAST_CALL_DAYS=21

# Cron Vercel — follow-ups do funil (/api/cron/brevo-funnel)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# HAXR Concierge — Google Gemini (tier gratuito para começar)
# Obter chave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternativa aceite pelo portal Concierge se GEMINI_API_KEY estiver vazia:
# GOOGLE_API_KEY=
# Opcional — default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Opcional — MCP Brevo no Cursor (não necessário na Vercel)
# BREVO_MCP_TOKEN=

# Edition RSVP write gate (Core API /api/v1/edition/rsvp)
# disabled (default) | preview_clone
# preview_clone requires VERCEL_ENV=preview and matching non-production ref.
HAXR_EDITION_RSVP_WRITE_MODE=disabled
# Allowed Supabase project ref for preview_clone (never production oxsrdmydlqyvnueedgtl)
HAXR_EDITION_RSVP_ALLOWED_SUPABASE_REF=
